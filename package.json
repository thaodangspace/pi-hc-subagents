{
  "name": "pi-hc-subagents",
  "version": "0.2.0-rc.1",
  "description": "Delegate tasks to interactive pi subagents running in herdr-core terminals",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "child.ts",
    "src",
    "agents",
    "README.md",
    "SPEC.md",
    "PLAN.md",
    "AGENTS.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit/*.test.ts",
    "test:contract": "node --test test/contract/*.test.ts",
    "test:integration": "node --test test/integration/*.test.ts",
    "test:all": "npm run test && npm run test:contract && npm run test:integration"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0",
    "typebox": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "22.20.5",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
